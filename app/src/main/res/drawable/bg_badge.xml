<?xml version="1.0" encoding="utf-8"?>
<!-- Define uma forma retangular para o emblema -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Cor de fundo: Azul escuro com transparência (CC = 80%) -->
    <solid android:color="#CC080B14" />

    <!-- Borda (Stroke): 1dp de espessura na cor dourada translúcida -->
    <stroke android:width="1dp" android:color="#3DF5C842" />

    <!-- Cantos: Arredondamento de 20dp para dar o efeito de "pílula" -->
    <corners android:radius="20dp" />
</shape>