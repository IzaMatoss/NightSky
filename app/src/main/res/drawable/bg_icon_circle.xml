<?xml version="1.0" encoding="utf-8"?>
<!-- Define uma forma oval (que se torna um círculo perfeito se o tamanho for igual) -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">

    <!-- Cor de fundo: Um tom de azul espacial profundo -->
    <solid android:color="#1A2540" />

    <!-- Borda (Stroke): 1dp de espessura com um azul um pouco mais claro para dar relevo -->
    <stroke android:width="1dp" android:color="#253660" />
</shape>