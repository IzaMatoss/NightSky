<?xml version="1.0" encoding="utf-8"?>
<!-- Define uma forma retangular para os blocos de dados do GPS -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Cor de preenchimento: Um azul levemente mais claro que o fundo (Card Accent) -->
    <solid android:color="#141E35" />

    <!-- Borda (Stroke): 1dp de espessura com uma cor azul metálica -->
    <stroke android:width="1dp" android:color="#1E2D4A" />

    <!-- Cantos: Arredondamento de 10dp para um visual suave e moderno -->
    <corners android:radius="10dp" />
</shape>