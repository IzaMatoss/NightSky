<?xml version="1.0" encoding="utf-8"?>
<!-- Define uma forma retangular para o selo de status de visibilidade -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Cor de fundo: Um azul marinho profundo (Nebula Blue escurecido) -->
    <solid android:color="#0D2A4A" />

    <!-- Borda (Stroke): 1dp de espessura para dar definição ao selo -->
    <stroke android:width="1dp" android:color="#1A4A80" />

    <!-- Cantos: Arredondamento leve de 6dp para um visual mais técnico e quadrado -->
    <corners android:radius="6dp" />
</shape>